NODE_ENV=development

WEB_PORT=3000
API_PORT=3001
AGENT_RUNTIME_PORT=3002
AGENT_RUNTIME_URL=http://127.0.0.1:3002
API_INTERNAL_URL=http://127.0.0.1:3001
# API 与 Runtime 共用；本地生成后只写入 .env，不要提交真实值
INTERNAL_SHARED_SECRET=
# Runtime 的 Pi JSONL 会话与空工作目录
AGENT_RUNTIME_DATA_DIR=D:\PiChat\runtime-data
AGENT_RUN_TIMEOUT_MS=300000
AGENT_MODEL_CONTEXT_WINDOW=128000
AGENT_MODEL_MAX_TOKENS=8192

# 知识库工具
KB_SEARCH_TOP_K=6
KB_SEARCH_MAX_TOP_K=12
KB_SEARCH_SIMILARITY_THRESHOLD=0.2
KB_SEARCH_VECTOR_WEIGHT=0.3
KB_SEARCH_MAX_SNIPPET_CHARS=1200
KB_SEARCH_MAX_RESULT_CHARS=12000
RAGFLOW_TIMEOUT_MS=30000

# 本机 MySQL 使用 3306；Docker Compose 映射到 3307
DATABASE_URL=mysql://pichat:pichat_dev@127.0.0.1:3306/pichat
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=D:\PiChat\uploads
UPLOAD_MAX_BYTES=20971520
# 32 字节随机值的 base64；本地生成后只写入 .env，不要提交真实值
MODEL_CONFIG_ENCRYPTION_KEY=

RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
# 创建 RAGFlow 数据集时必填，填写实际部署的 embedding 模型名
RAGFLOW_DEFAULT_EMBEDDING_MODEL=
RAGFLOW_POLL_INTERVAL_MS=3000
RAGFLOW_POLL_TIMEOUT_MS=300000

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=pichat
S3_ACCESS_KEY=pichat
S3_SECRET_KEY=pichat_dev_secret

AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

DEFAULT_MODEL_PROVIDER=openai
DEFAULT_MODEL_ID=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
